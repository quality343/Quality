# PostgreSQL connection string
# Local dev: project-local instance on port 5433 (scripts/dev-db-start.ps1)
DATABASE_URL="postgresql://qhc:qhc@127.0.0.1:5433/quality_hearing_care?schema=public"

# Auth.js v5 secret — REQUIRED. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Set to "true" in deployments where the app runs behind a proxy/host you control
AUTH_TRUST_HOST=""

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

