# QUALITY Hearing Care — environment template.
# Copy to `.env` for local development. Never commit real secrets.
#
# For production (Netlify) see docs/DEPLOYMENT.md for the exact list and values.

# ─── Database (Turso / libSQL) ───────────────────────────────────────────────

# The application database is Turso (libSQL/SQLite). Both values come from the
# Turso dashboard, or the CLI:
#   turso db show <database> --url
#   turso db tokens create <database>
#
# TURSO_AUTH_TOKEN grants READ-WRITE access to all clinic data — every
# appointment and every patient's contact details. Treat it as a password:
# never commit it, never log it, and never give it a NEXT_PUBLIC_ prefix (that
# would ship it to every browser). Rotate it if it is ever shared or exposed.
TURSO_DATABASE_URL="libsql://your-database-your-org.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN=""

# A local SQLite file also works, needs no token, and is useful for offline work:
# TURSO_DATABASE_URL="file:./local.db"
#
# NOTE: the PostgreSQL DATABASE_URL / DIRECT_URL this project used before the
# Turso migration are no longer read by the application.

# ─── Authentication ──────────────────────────────────────────────────────────

# Auth.js v5 secret — REQUIRED. Generate: openssl rand -base64 32
# Use a different value in every environment.
AUTH_SECRET=""

# REQUIRED = "true" on Netlify. Auth.js v5 auto-trusts the host only on
# Vercel/Cloudflare; without this, staff sign-in fails with UntrustedHost.
AUTH_TRUST_HOST=""

# ─── Public site ─────────────────────────────────────────────────────────────

# Canonical origin. Inlined at BUILD time (canonical tags, sitemap.xml,
# robots.txt), so changing it requires a redeploy.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Deploy controls (optional) ──────────────────────────────────────────────

# Set "true" on a branch/preview deploy that should build without a database.
# SKIP_DB_MIGRATE="false"
# Set "true" only to bypass the build-time environment check (emergency use).
# SKIP_ENV_CHECK="false"

# ─── Google Sheets appointment mirror (optional) ─────────────────────────────
# Mirrors each new appointment into a spreadsheet as a SECONDARY reporting copy.
# Turso stays the source of truth; if these are unset, bookings work exactly as
# before and simply are not mirrored.
#
# Setup walkthrough: docs/google-sheets/README.md
#
# GOOGLE_SHEETS_WEBHOOK_URL — the Apps Script web-app URL, ending in /exec
#   (NOT /dev, which only works while you are signed in to Google).
# GOOGLE_SHEETS_WEBHOOK_SECRET — a long random string. Generate with:
#   openssl rand -hex 32
#   The SAME value must be stored in the Apps Script project as a script
#   property named SHEET_WEBHOOK_SECRET. It signs every request, so without it
#   random visitors could inject rows into the spreadsheet.
#
# Both are server-only. Never give either a NEXT_PUBLIC_ prefix.
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_SHEETS_WEBHOOK_SECRET=""
# Optional: how long to wait for the webhook before giving up (ms).
# GOOGLE_SHEETS_TIMEOUT_MS="8000"

# ─── Notifications ───────────────────────────────────────────────────────────
# NO provider is implemented yet, so nothing is ever sent. Leave these unset —
# setting them to "true" would claim messages were delivered. Connect a provider
# in src/lib/notifications.ts first.
# NOTIFY_EMAIL="false"
# NOTIFY_SMS="false"

# ─── One-time bootstrap scripts ──────────────────────────────────────────────
# Run once, then REMOVE the values from this file.

# Real clinic admin account (scripts/provision-admin.ts). Required for
# production — the test suite's admin must not be used as a real login.
# ADMIN_NAME=""
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_PHONE=""
# ADMIN_DESIGNATION=""

# Legacy SUPER_ADMIN bootstrap (scripts/seed-super-admin.ts). That role is
# deferred for the single-clinic product; keep this unset unless it is needed.
# SUPER_ADMIN_NAME=""
# SUPER_ADMIN_EMAIL=""
# SUPER_ADMIN_PASSWORD=""
